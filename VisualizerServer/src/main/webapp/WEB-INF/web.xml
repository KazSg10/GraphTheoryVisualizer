	xsi:schemaLocation="https://xmlns.jcp.org/ns/javaee
	https://xmlns.jcp.org/ns/javaee/web-app_3_1.xsd"
	version="3.1">
	
	<servlet>
		<servlet-name>GraphTheoryAlgorithmsVisualizer</servlet-name>
		<servlet-class>com.servlet.VisualizerServlet</servlet-class>
